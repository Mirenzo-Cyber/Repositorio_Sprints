{
  "info": {
    "name": "Trabalho 02 - Testes de Integração API",
    "description": "Coleção de testes para validar as operações REST do inventário de ativos.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. GET - Listar Ativos",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "// Passo 1: Verificamos se o servidor respondeu com sucesso",
              "pm.test(\"Status code deve ser 200 OK\", function () {",
              "    pm.response.to.have.status(200);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "url": {
          "raw": "http://localhost:5000/api/ativos",
          "protocol": "http",
          "host": ["localhost"],
          "port": "5000",
          "path": ["api", "ativos"]
        }
      }
    },
    {
      "name": "2. POST - Criar Novo Ativo",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "// Passo 2: O código 201 significa 'Criado'. O teste passa se a API criar o ativo corretamente.",
              "pm.test(\"Status code deve ser 201 Created\", function () {",
              "    pm.response.to.have.status(201);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nome\": \"Firewall Secundário\",\n  \"categoria\": \"Rede\",\n  \"nivelRisco\": \"Médio\"\n}"
        },
        "url": {
          "raw": "http://localhost:5000/api/ativos",
          "protocol": "http",
          "host": ["localhost"],
          "port": "5000",
          "path": ["api", "ativos"]
        }
      }
    },
    {
      "name": "3. PUT - Atualizar Ativo (ID: 1)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "// Passo 3: Testamos se a atualização ocorreu bem e devolveu um código 200.",
              "pm.test(\"Status code deve ser 200 OK\", function () {",
              "    pm.response.to.have.status(200);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nome\": \"Servidor Web Atualizado\",\n  \"categoria\": \"Hardware\",\n  \"nivelRisco\": \"Baixo\"\n}"
        },
        "url": {
          "raw": "http://localhost:5000/api/ativos/1",
          "protocol": "http",
          "host": ["localhost"],
          "port": "5000",
          "path": ["api", "ativos", "1"]
        }
      }
    },
    {
      "name": "4. DELETE - Apagar Ativo (ID: 1)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "// Passo 4: O código 204 indica que a eliminação foi feita e não há conteúdo a mostrar (No Content).",
              "pm.test(\"Status code deve ser 204 No Content\", function () {",
              "    pm.response.to.have.status(204);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "DELETE",
        "url": {
          "raw": "http://localhost:5000/api/ativos/1",
          "protocol": "http",
          "host": ["localhost"],
          "port": "5000",
          "path": ["api", "ativos", "1"]
        }
      }
    }
  ]
}